# This project is configured to run on OpenAI. Without a key below the
# Council still runs end-to-end on a rule-based simulation with the identical
# output contract. Set OPENAI_API_KEY to get live reasoning from the five
# specialists and the Chair.
OPENAI_API_KEY=

# Optional — a Claude key works too (checked if OPENAI_API_KEY isn't set).
ANTHROPIC_API_KEY=

# Defaults shown; override if needed.
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-sonnet-5
AUTO_EXECUTE_THRESHOLD=0.9
PORT=8787
