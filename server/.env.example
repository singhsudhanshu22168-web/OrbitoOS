# Optional — without either key below the Council still runs end-to-end on a
# rule-based simulation with the identical output contract. Set ONE of these
# to get live reasoning from the five specialists and the Chair.
# ANTHROPIC_API_KEY takes precedence if both are set.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Defaults shown; override if needed.
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_MODEL=gpt-4o-mini
AUTO_EXECUTE_THRESHOLD=0.9
PORT=8787
